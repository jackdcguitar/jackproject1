# ==========================================
# Git 忽略檔案配置
# 用途：指定不需要提交到 Git 的檔案和目錄
# ==========================================

# ==================== Java / Spring Boot ====================

# Maven
backend/target/
backend/pom.xml.tag
backend/pom.xml.releaseBackup
backend/pom.xml.versionsBackup
backend/pom.xml.next
backend/release.properties
backend/dependency-reduced-pom.xml
backend/buildNumber.properties
backend/.mvn/timing.properties
backend/.mvn/wrapper/maven-wrapper.jar

# Gradle
backend/.gradle/
backend/build/
backend/!gradle/wrapper/gradle-wrapper.jar

# IntelliJ IDEA
backend/.idea/
backend/*.iws
backend/*.iml
backend/*.ipr
backend/out/

# Eclipse
backend/.apt_generated/
backend/.classpath
backend/.factorypath
backend/.project
backend/.settings/
backend/.springBeans
backend/.sts4-cache/
backend/bin/

# NetBeans
backend/nbproject/private/
backend/nbbuild/
backend/dist/
backend/nbdist/
backend/.nb-gradle/

# VS Code
backend/.vscode/

# 日誌檔案
backend/*.log
backend/logs/
backend/spring.log

# 臨時檔案
backend/tmp/
backend/*.tmp

